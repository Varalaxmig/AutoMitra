# AutoMitra — Environment Configuration Template
# Copy to .env.local for local development

# ============================================================
# 1. Telegram Bot (100% Free Live Push Alerts)
# Create bot with @BotFather and get chat ID with @userinfobot
# ============================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
VITE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
VITE_TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================================
# 2. Supabase (The ONLY Cloud Database Needed)
# Sign up at: https://supabase.com (Region: Mumbai ap-south-1)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# 3. App Settings
# ============================================================
BASE_URL=http://localhost:3000
NODE_ENV=development
HMAC_SECRET_KEY=automitra_secret_hmac_key_min_32_chars_123456
