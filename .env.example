# AutoMitra — Environment Configuration Template
# Copy to .env.local for local development or set in Vercel Project Settings

# ============================================================
# 1. Supabase (Database & Authentication)
# Region: Mumbai (ap-south-1)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ============================================================
# 2. TextBee (Free Cellular SMS via Android Phone Gateway)
# ============================================================
TEXTBEE_API_KEY=your-textbee-api-key
TEXTBEE_DEVICE_ID=your-textbee-device-id

VITE_TEXTBEE_API_KEY=your-textbee-api-key
VITE_TEXTBEE_DEVICE_ID=your-textbee-device-id

MAX_SMS_PER_PHONE=50

# ============================================================
# 3. Security & App Settings
# ============================================================
HMAC_SECRET_KEY=automitra_secret_hmac_key_min_32_chars_123456
BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
