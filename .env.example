# AutoMitra — Environment Configuration Template
# Copy to .env.local for local development

# ============================================================
# 1. Fast2SMS (The ONLY SMS Gateway Needed)
# Sign up at: https://www.fast2sms.com
# Use route 'q' (Quick route) — NO DLT registration needed!
# ============================================================
FAST2SMS_API_KEY=your-fast2sms-api-key
SMS_ROUTE=q

# ============================================================
# 2. Supabase (The ONLY Cloud Database Needed)
# Sign up at: https://supabase.com (Region: Mumbai ap-south-1)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# 3. App Settings
# ============================================================
BASE_URL=http://localhost:3000
NODE_ENV=development
HMAC_SECRET_KEY=automitra_secret_hmac_key_min_32_chars_123456
